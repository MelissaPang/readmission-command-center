{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "ds_kpi",
      "queryLines": [
        "SELECT h.estimated_penalty, h.largest_condition_contribution AS hf_line, h.largest_condition_err AS hf_err,\n  u.last_20w_rate_pct AS sixn_last20, u.prior_20w_rate_pct AS sixn_prior20\nFROM cedarbrook_rcc.gold.hrrp_hospital_penalty h CROSS JOIN cedarbrook_rcc.gold.unit_period_summary u\nWHERE h.hospital_id = 'CUMC' AND u.unit_id = 'CUMC-6N' AND u.condition = 'HF'"
      ]
    },
    {
      "name": "ds_units",
      "displayName": "ds_units",
      "queryLines": [
        "SELECT concat(unit_name, ' (', hospital_id, ')') AS unit, delta_pts, prior_20w_rate_pct, last_20w_rate_pct FROM cedarbrook_rcc.gold.unit_period_summary WHERE condition = 'ALL'"
      ]
    },
    {
      "name": "ds_weekly",
      "displayName": "ds_weekly",
      "queryLines": [
        "SELECT discharge_week, CASE WHEN unit_id = 'CUMC-6N' THEN '6 North Telemetry' ELSE 'All other units' END AS unit_group,\n  sum(readmissions) AS readmissions, sum(index_admissions) AS index_admissions,\n  round(100 * sum(readmissions) / sum(index_admissions), 1) AS readmit_rate_pct\nFROM cedarbrook_rcc.gold.unit_weekly_readmissions WHERE condition = 'HF' AND discharge_week >= '2025-12-29' GROUP BY ALL"
      ]
    },
    {
      "name": "ds_gap",
      "displayName": "ds_gap",
      "queryLines": [
        "SELECT discharge_day_type, period, fu7_booked_pct, discharges FROM cedarbrook_rcc.gold.followup_gap WHERE unit_id = 'CUMC-6N' AND condition = 'HF'"
      ]
    },
    {
      "name": "ds_penalty",
      "displayName": "ds_penalty",
      "queryLines": [
        "SELECT hospital_id, hrrp_condition, err, penalty_contribution, observed_rate, expected_readmission_rate, index_admissions, readmissions FROM cedarbrook_rcc.gold.hrrp_condition_err"
      ]
    },
    {
      "name": "ds_whatif",
      "displayName": "ds_whatif",
      "queryLines": [
        "SELECT fu7_target_pct, readmissions_avoided, penalty_saved, hf_err_scenario FROM cedarbrook_rcc.gold.hrrp_whatif WHERE scope = '6N weekend HF'"
      ]
    },
    {
      "name": "ds_factors",
      "displayName": "ds_factors",
      "queryLines": [
        "SELECT concat(factor, ' = ', value) AS factor_value, readmit_rate_pct, index_admissions\nFROM cedarbrook_rcc.gold.readmission_risk_factors WHERE condition = 'HF' AND factor IN ('fu7_booked', 'ai_lives_alone', 'ai_transport_barrier')"
      ]
    },
    {
      "name": "ds_tiers",
      "displayName": "ds_tiers",
      "queryLines": [
        "SELECT risk_tier, count(*) AS index_admissions, round(100 * avg(CAST(readmit_30d AS INT)), 1) AS observed_readmit_pct\nFROM cedarbrook_rcc.gold.patient_risk_scores WHERE outcome_complete GROUP BY risk_tier"
      ]
    },
    {
      "name": "ds_whatif80",
      "displayName": "ds_whatif80",
      "queryLines": [
        "SELECT fu7_target_pct, readmissions_avoided, penalty_saved, hf_err_scenario FROM cedarbrook_rcc.gold.hrrp_whatif WHERE scope = '6N weekend HF' AND fu7_target_pct = 80"
      ]
    }
  ],
